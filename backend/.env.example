# Debate Engine Backend 环境变量示例
# 复制为 .env 并填入实际值。所有 Key 均可留空（对应服务商自动跳过）。

# ---- LLM API Keys（免费注册地址见注释）----
GROQ_API_KEY=            # https://console.groq.com （永久免费层）
GEMINI_API_KEY=          # https://aistudio.google.com （永久免费层）
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai （永久免费层）
MISTRAL_API_KEY=         # https://console.mistral.ai （免费评估模式）
OPENROUTER_API_KEY=      # https://openrouter.ai （18个免费模型）

# ---- 本地 Ollama（可选）----
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ---- 路径覆盖（可选，默认在项目根目录）----
# KB_PATH=D:\debate_kb
# BGE_M3_PATH=D:\models\bge-m3

# ---- 日志隐私级别：minimal / standard / debug ----
LOG_PRIVACY_LEVEL=minimal

# ---- 自定义服务商（JSON 数组，可选）----
# CUSTOM_PROVIDERS=[{"name":"siliconflow","url":"https://api.siliconflow.cn/v1","key":"sk-xxx","model":"Qwen/Qwen2.5-72B-Instruct"}]
